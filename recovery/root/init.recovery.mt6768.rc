import /init.microtrust.rc

on init
    export LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.configfs 1

on early-fs
    start vold

on post-fs
    exec u:r:recovery:s0 -- /system/bin/sh /system/bin/prep_keymaster.sh
    mount_all /vendor/etc/fstab.${ro.boot.hardware.platform} --late

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    class hal
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw
    seclabel u:r:recovery:s0

service keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    class early_hal
    user root
    group root drmrpc
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw
    seclabel u:r:recovery:s0

service soter-1-0 /vendor/bin/hw/vendor.microtrust.hardware.soter@1.0-service
    class hal
    user root
    group root
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/system/lib64/hw
    seclabel u:r:recovery:s0

on property:twrp.keymaster.ready=1
    start keymaster-4-0
    start gatekeeper-1-0
    start soter-1-0

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0
    stop soter-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0
    stop soter-1-0

on property:twrp.decrypt.done=true && property:twrp.all.users.decrypted=true
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0
    stop soter-1-0
